# ===========================================
# Todo App - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values
#   cp .env.example .env.local

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Secret key for signing JWT session tokens (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# -------------------------------------------
# WebAuthn / Passkey Configuration
# -------------------------------------------
# Relying Party ID — your domain without protocol or port
#   Local:      localhost
#   Vercel:     your-app.vercel.app
#   Railway:    your-app.up.railway.app
WEBAUTHN_RP_ID=localhost

# Relying Party display name shown in passkey prompts
WEBAUTHN_RP_NAME=Todo App

# Full origin URL (protocol + domain + optional port)
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app
WEBAUTHN_ORIGIN=http://localhost:3000

# -------------------------------------------
# Node Environment
# -------------------------------------------
# Set to "production" for deployed environments
# NODE_ENV=production

# -------------------------------------------
# Railway-specific (only needed on Railway)
# -------------------------------------------
# Railway injects PORT automatically — no need to set manually
# PORT=3000
#
# Railway volume mount path for persistent SQLite database
# Set via Railway dashboard when attaching a volume
RAILWAY_VOLUME_MOUNT_PATH=/app/data
