# JWT secret for session tokens (use a strong random string in production)
JWT_SECRET=change-me-to-a-random-secret

# WebAuthn Relying Party configuration
# RP_ID: The domain name (no protocol, no port)
# Production example: your-app.up.railway.app
RP_ID=localhost
# RP_NAME: Human-readable application name
RP_NAME=Todo App
# RP_ORIGIN: Full origin URL (protocol + domain + port)
# Production example: https://your-app.up.railway.app
RP_ORIGIN=http://localhost:3000

# SQLite database path
# Default: ./todo.db (relative to project root)
# Railway volume example: /data/todo.db
DATABASE_PATH=./todo.db

# Node environment
NODE_ENV=development
